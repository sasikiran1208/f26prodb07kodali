
extends layout

block content
  h1= title
  p Welcome to my Web Applications Assignment 10
  button(type="button", class="btn btn-secondary", onclick="reduce()") Sample Button
  div#use Take some away
  p
    a(href="/gardens") View Gardens Search Results


  script.
    let current = 11;
    let quantity = 2;

    function reduce() {
      current = current - quantity;
      if (current < 0) {
        current = 0;
      }
      document.getElementById("use").textContent =
        `Reduced by ${quantity} to ${current}`;
    }
    