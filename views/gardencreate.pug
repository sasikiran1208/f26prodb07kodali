extends layout

block content
  h1= title
  form#gardenForm(action='/resource/gardens' method='post')
    div.mb-3
      label.form-label(for='name') Garden Name
      input.form-control#name(type='text' name='name' required)
    div.mb-3
      label.form-label(for='location') Location
      input.form-control#location(type='text' name='location' required)
    div.mb-3
      label.form-label(for='areaAcres') Area in acres
      input.form-control#areaAcres(type='number' name='areaAcres' step='any' required)
    div.mb-3
      label.form-label(for='yearOpened') Year opened
      input.form-control#yearOpened(type='number' name='yearOpened' required)
    button.btn.btn-primary(type='submit') Create Garden

  script.
    document.getElementById('gardenForm').addEventListener('submit', async function(event) {
      // Send the form to the existing API and stay on this page.
      event.preventDefault();
      const form = event.target;
      const button = form.querySelector('button[type="submit"]');
      button.disabled = true;

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new URLSearchParams(new FormData(event.target))
        });
        if (!response.ok) {
          const result = await response.json().catch(() => ({}));
          alert(result.error || `Could not create the garden (HTTP ${response.status}).`);
          return;
        }
        alert('Garden created successfully!');
        form.reset();
      } catch (error) {
        alert('Could not reach the server. Check your connection and try again.');
      } finally {
        button.disabled = false;
      }
    });
