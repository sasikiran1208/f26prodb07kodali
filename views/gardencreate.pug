extends layout

block content
  h1= title

  form(id='GardenForm', action="/resource/gardens", method="POST")
    div.form-group
      label(for='name') Garden Name
      input#name(type='text', name='name')
    div.form-group
      label(for='location') Location
      input#location(type='text', name='location')
    div.form-group
      label(for='areaAcres') Area in acres
      input#areaAcres(type='number', name='areaAcres')
    div.form-group
      label(for='yearOpened') Year opened
      input#yearOpened(type='number', name='yearOpened')
    input(type="submit")

  script.
    document.forms['GardenForm'].addEventListener('submit', (event) => {
      event.preventDefault();
      // Send the form data to the Garden REST API.
      fetch(event.target.action, {
        method: 'POST',
        body: new URLSearchParams(new FormData(event.target))
      }).then((resp) => {
        return resp.json();
      }).then((body) => {
        alert("Save succeded")
      });
    });
