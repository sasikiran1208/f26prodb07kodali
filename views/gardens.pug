
extends layout

block content
  h1= title
  p Welcome to the Gardens Search Results page.

  div.container-fluid
    div.row
      each garden, index in results
        div.col-sm-2
          h4= garden.name
          p Location: #{garden.location}
          p Area: #{garden.areaAcres} acres
          p Opened: #{garden.yearOpened}
          button.btn.btn-primary(onclick=`dispatch("/gardens/update?id=${garden._id}")`) Update

  script.
    function dispatch(path) {
      window.location.href = path;
    }
